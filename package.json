{
  "name": "@apexdevtools/apex-log-parser",
  "version": "0.4.0",
  "description": "Fast Apex log parser for Salesforce debug logs: a typed call tree with timings, governor limits and SOQL/DML counts. TypeScript, Node.js and browser.",
  "type": "module",
  "sideEffects": ["./dist/worker-node.js", "./dist/worker-browser.js"],
  "exports": {
    ".": {
      "node": {
        "types": "./dist/node.d.ts",
        "import": "./dist/node.js"
      },
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./worker": {
      "node": "./dist/worker-node.js",
      "default": "./dist/worker-browser.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/node.js",
  "types": "./dist/node.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.dom.json",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "node --run bench:bundle && node --run bench:run",
    "bench:bundle": "tsdown -c tsdown.bench.config.ts --logLevel warn",
    "bench:run": "vitest bench --run",
    "bench:large": "node --run bench:bundle && node --expose-gc --max-old-space-size=8192 --import tsx benchmarks/scripts/large.ts",
    "bench:simulation": "node --run bench:bundle && node --no-opt --no-maglev --predictable --hash-seed=1 --random-seed=1 --expose-gc --max-old-space-size=8192 --import tsx benchmarks/scripts/large.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "ci": "biome check . && node --run typecheck && node --run typecheck:scripts && vitest run",
    "version:packages": "changeset version && biome check --write package.json",
    "prepublishOnly": "pnpm run build",
    "scrape": "tsx scripts/scrape.ts",
    "validate:data": "tsx scripts/validate-data.ts",
    "ci:seed": "tsx scripts/ci/seed.ts",
    "ci:report": "tsx scripts/ci/report.ts",
    "compare": "node --max-old-space-size=12288 --import tsx benchmarks/scripts/compare/compare.ts",
    "bench:views": "node --expose-gc --max-old-space-size=8192 --import tsx benchmarks/scripts/views.ts",
    "bench:async": "node --max-old-space-size=8192 --import tsx benchmarks/scripts/async.ts",
    "bench:readme": "node --run bench:bundle && node --expose-gc --max-old-space-size=8192 --import tsx benchmarks/scripts/readme.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@changesets/cli": "^3.0.3",
    "@codspeed/vitest-plugin": "^6.1.0",
    "@types/node": "^26.6.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "node-html-parser": "^9.0.5",
    "tsdown": "^0.23.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "unrun": "^0.3.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.8.0",
  "license": "BSD-3-Clause",
  "author": "Certinia Inc.",
  "homepage": "https://github.com/apex-dev-tools/apex-log-parser#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/apex-dev-tools/apex-log-parser"
  },
  "bugs": {
    "url": "https://github.com/apex-dev-tools/apex-log-parser/issues"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "keywords": [
    "salesforce",
    "salesforce-apex",
    "apex",
    "sfdc",
    "debug-log",
    "debug-logs",
    "apex-debug-log",
    "salesforce-debug-log",
    "apex-log",
    "apex-logs",
    "parser",
    "log-parser",
    "debug-log-parser",
    "apex-log-parser",
    "soql",
    "dml",
    "governor-limits",
    "log-analysis",
    "call-tree",
    "performance",
    "developer-tools",
    "typescript",
    "javascript",
    "nodejs",
    "browser"
  ],
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "esbuild"],
    "ignoredBuiltDependencies": ["@codspeed/core"]
  }
}
