{
  "name": "@apexdevtools/apex-log-parser",
  "version": "0.3.0",
  "description": "Turn a Salesforce Apex debug log into a typed event tree with execution timings, governor limits and SOQL/DML counts. No dependencies.",
  "type": "module",
  "sideEffects": ["./dist/next/worker-node.js", "./dist/next/worker-browser.js"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./next": {
      "node": {
        "types": "./dist/next/node.d.ts",
        "import": "./dist/next/node.js"
      },
      "types": "./dist/next/browser.d.ts",
      "import": "./dist/next/browser.js"
    },
    "./next/worker": {
      "node": "./dist/next/worker-node.js",
      "default": "./dist/next/worker-browser.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "bench:large": "node --expose-gc --max-old-space-size=8192 --import tsx benchmarks/scripts/large.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "ci": "biome check . && tsc --noEmit && tsc -p tsconfig.scripts.json && vitest run",
    "version:packages": "changeset version && biome check --write package.json",
    "prepublishOnly": "pnpm run build",
    "scrape": "tsx scripts/scrape.ts",
    "validate:data": "tsx scripts/validate-data.ts",
    "ci:seed": "tsx scripts/ci/seed.ts",
    "ci:report": "tsx scripts/ci/report.ts",
    "compare": "node --max-old-space-size=12288 --import tsx benchmarks/scripts/compare/compare.ts",
    "bench:views": "node --expose-gc --max-old-space-size=8192 --import tsx benchmarks/scripts/views.ts",
    "bench:async": "node --max-old-space-size=8192 --import tsx benchmarks/scripts/async.ts",
    "bench:micro": "node --import tsx benchmarks/scripts/micro/micro.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@changesets/cli": "^3.0.3",
    "@codspeed/vitest-plugin": "^5.7.1",
    "@types/node": "^26.6.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "node-html-parser": "^9.0.4",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "unrun": "^0.3.1",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.8.0",
  "license": "BSD-3-Clause",
  "author": "Certinia Inc.",
  "homepage": "https://github.com/apex-dev-tools/apex-log-parser#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/apex-dev-tools/apex-log-parser"
  },
  "bugs": {
    "url": "https://github.com/apex-dev-tools/apex-log-parser/issues"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "keywords": [
    "salesforce",
    "salesforce-apex",
    "apex",
    "sfdc",
    "debug-log",
    "debug-logs",
    "apex-log",
    "apex-logs",
    "parser",
    "log-parser",
    "soql",
    "dml",
    "governor-limits",
    "log-analysis",
    "call-tree",
    "performance",
    "developer-tools",
    "typescript"
  ],
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "esbuild"],
    "ignoredBuiltDependencies": ["@codspeed/core"]
  }
}
